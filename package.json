{
  "name": "concent-market",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:concent-market": "node dist/concent-market/server/server.mjs",
    "lint": "ng lint",
    "fmt": "prettier --write \"src/**/*.ts\" && prettier --parser angular --write \"./src/**/*.html\"",
    "prepare": "husky install",
    "script:image": "ts-node -P scripts/tsconfig.json scripts/generate-image",
    "prebuild": "npm run script:image"
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/platform-browser-dynamic": "^22.1.3",
    "@angular/platform-server": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@angular/ssr": "^22.1.5",
    "@ionic/angular": "^9.0.0",
    "express": "5.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.17",
    "@types/node": "^22.0.0",
    "angular-eslint": "22.1.0",
    "eslint": "^10.9.1",
    "husky": "^9.0.11",
    "image-size": "^1.1.1",
    "jsdom": "^26.0.0",
    "vitest": "^4.0.0",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "sharp": "^0.33.2",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
